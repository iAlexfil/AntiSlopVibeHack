# Скопируйте в .env и заполните нужные сервисы. Можно подключать не все.
HIVE_API_KEY=

SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

AIORNOT_API_KEY=

WASITAI_API_KEY=

# Только для SynthID / C2PA. Смысловой анализ использует отдельный OAuth-вход.
OPENAI_API_KEY=
# Модель смыслового анализа с лимитами плана ChatGPT; не использует API-ключ.
CHATGPT_VISION_MODEL=gpt-6-luna
