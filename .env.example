# Скопируйте в .env и заполните нужные сервисы. Можно подключать не все.
HIVE_API_KEY=

SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

AIORNOT_API_KEY=

WASITAI_API_KEY=

# Общий ключ для опциональных OpenAI Vision и SynthID / C2PA проверок.
OPENAI_API_KEY=
# Модель только для смыслового анализа через Responses API.
OPENAI_VISION_MODEL=gpt-6-luna
